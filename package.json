{
  "name": "pweb-express-modul-4",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend Express MLBB Shop - Praktikum Modul 4",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "prisma": "^7.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
